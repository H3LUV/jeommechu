{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jeommechu",
  "main": "./src/main.js",
  "compatibility_date": "2026-08-05",
  "secrets": {
    "required": ["KAKAO_REST_API_KEY"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TEAM_ROOMS",
        "class_name": "TeamRoom"
      }
    ]
  },
  "exports": {
    "TeamRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}